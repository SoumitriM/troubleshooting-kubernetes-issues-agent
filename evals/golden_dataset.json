    {
      "id": "incident-fix-01",
      "category": "incident_fix",
      "query": "Our GCE e2e job fails: error during ./hack/e2e-internal/e2e-up.sh: exit status 1, Failed to create master instance due to non-retryable error",
      "expect": {
        "status": "completed",
        "intent": "INCIDENT_TROUBLESHOOTING",
        "route": "generate_fix",
        "answer_contains": [
          "Verified steps",
          "images list"
        ],
        "citations_contain": [
          "pull/141082"
        ],
        "min_citations": 1
      }
    },
