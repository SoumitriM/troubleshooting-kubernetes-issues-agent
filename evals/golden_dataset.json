{
  "description": "Golden end-to-end queries for the routed Kubernetes knowledge assistant. Graph expectations are tied to the 100 issues in data/processed/ loaded into Neo4j; documentation expectations to the official Kubernetes docs index.",
  "cases": [
    {
      "id": "doc-01",
      "category": "documentation",
      "query": "What does the kubelet do?",
      "expect": {
        "status": "completed",
        "intent": "GENERAL_KUBERNETES_QUESTION",
        "route": "general_answer",
        "answer_contains": [
          "node"
        ],
        "citations_contain": [
          "kubelet"
        ],
        "citations_prefix": "https://kubernetes.io/docs/",
        "min_citations": 1,
        "min_suggestions": 1
      }
    },
