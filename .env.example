APP_ENV=development
GITHUB_TOKEN=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
ANTHROPIC_API_KEY=
# api | claude_code (local development: reuse the Claude Code login, no API key)
LLM_BACKEND=api
LLM_CLAUDE_CODE_PATH=claude
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_REFUSAL_FALLBACK=true

# Optional LangSmith tracing (off by default). Traces include user messages,
# prompts and issue text unless the HIDE settings are true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kubesage
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
AGENT_RELEVANCE_THRESHOLD=0.55
AGENT_ACTIONABLE_FIX_THRESHOLD=0.65
DOCUMENTATION_INDEX_PATH=data/kubernetes_docs.sqlite
RETRIEVAL_MIN_VECTOR_SCORE=0.55
RETRIEVAL_EXCEPTIONAL_VECTOR_SCORE=0.90
RETRIEVAL_MIN_FINAL_RELEVANCE_SCORE=0.55
RETRIEVAL_MIN_RELATIVE_SCORE_RATIO=0.85
